# Copy to secrets.yaml (next to filament-selector.yaml) and fill in. Never commit secrets.yaml.
wifi_ssid: "your 2.4 GHz network name"
wifi_password: "your wifi password"
# ESPHome native API encryption key. Generate one with:  openssl rand -base64 32
api_encryption_key: "paste-a-32-byte-base64-key-here"
# Password for the fallback access point the device opens if WiFi fails (8+ characters).
ap_password: "choose-a-fallback-password"
# Only needed if Bambuddy authentication is turned on: an API key with Read + Inventory permissions.
bambuddy_api_key: "paste-bambuddy-api-key-here"
